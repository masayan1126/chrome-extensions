# Chrome Web Store API 用 credentials の雛形。
# このファイルをコピーして .env を作成し、実際の値を入れてください。
# .env は .gitignore で除外されています。
#
# 取得手順は docs/cws-api-setup.md 参照。

# Developer Dashboard の URL に含まれる UUID
# 例: https://chrome.google.com/webstore/devconsole/329b08a0-...
CWS_EXTENSION_ID=

# Google Cloud Console > 認証情報 > OAuth クライアント ID (デスクトップアプリ)
CWS_CLIENT_ID=
CWS_CLIENT_SECRET=

# scripts/get-cws-refresh-token.mjs で取得
CWS_REFRESH_TOKEN=

# (任意) 公開ターゲット: default | trustedTesters
# CWS_PUBLISH_TARGET=default

# (任意) 1 にするとアップロードのみで公開トリガーをスキップ
# CWS_SKIP_PUBLISH=0
